#!/bin/bash

if [[ -z $1 && $1 != "CNCLD" ]]; then
  echo "Usage: narchos-theme-set <theme-name>"
  exit 1
fi

THEMES_DIR="$HOME/.config/narchos/themes/"
CURRENT_THEME_DIR="$HOME/.config/narchos/current/theme"

THEME_NAME=$(echo "$1" | sed -E 's/<[^>]+>//g' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')
THEME_PATH="$THEMES_DIR/$THEME_NAME"

# Check if the theme entered exists
if [[ ! -d "$THEME_PATH" ]]; then
  echo "Theme '$THEME_NAME' does not exist in $THEMES_DIR"
  exit 1
fi

# Update theme symlinks
ln -nsf "$THEME_PATH" "$CURRENT_THEME_DIR"

# Change background with theme
narchos-theme-bg-next

# Restart components to apply new theme
if pgrep -x waybar >/dev/null; then
  narchos-restart-waybar
fi
narchos-restart-swayosd
hyprctl reload
pkill -SIGUSR2 btop
makoctl reload

# Change gnome themes
narchos-theme-set-terminal
narchos-theme-set-gnome
narchos-theme-set-browser

# Call hook on theme set
narchos-hook theme-set "$THEME_NAME"
