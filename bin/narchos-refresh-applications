#!/bin/bash

# Copy and sync icon files
mkdir -p /usr/local/share/icons/hicolor/48x48/apps/
cp /usr/local/share/narchos/applications/icons/*.png /usr/local/share/icons/hicolor/48x48/apps/
gtk-update-icon-cache /usr/local/share/icons/hicolor &>/dev/null

# Copy .desktop declarations
mkdir -p /usr/local/share/applications
cp /usr/local/share/narchos/applications/*.desktop /usr/local/share/applications/
cp /usr/local/share/narchos/applications/hidden/*.desktop /usr/local/share/applications/

update-desktop-database /usr/local/share/applications
