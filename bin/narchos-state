#!/bin/bash

SCOPE="$1"
COMMAND="$2"
STATE_NAME="$3"

if [[ -z "$COMMAND" ]]; then
  echo "Usage: narchos-state <system|user> <set|clear> <state-name-or-pattern>"
  exit 1
fi

if [[ -z "$STATE_NAME" ]]; then
  echo "Usage: narchos-state <system|user> $COMMAND <state-name-or-pattern>"
  exit 1
fi

if [[ -z "$SCOPE" ]]; then
  echo "Usage: narchos-state <system|user> $COMMAND <state-name-or-pattern>"
  exit 1
fi

STATE_DIR="/state/narchos"
case "$SCOPE" in
system) STATE_DIR=/usr/local/$STATE_DIR ;;
user) STATE_DIR=$HOME/.local/$STATE_DIR ;;
esac
mkdir -p "$STATE_DIR"

case "$COMMAND" in
set) touch "$STATE_DIR/$STATE_NAME" ;;
clear) find "$STATE_DIR" -maxdepth 1 -type f -name "$STATE_NAME" -delete ;;
esac
